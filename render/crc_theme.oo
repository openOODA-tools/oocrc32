// # oocrc32 Terminal Theming Subsystem
//
// Logline: Palette configurations and ANSI terminal styling primitives for CRC32 inspection.
//
// Setup: Pure string manipulation adhering to oote theme specifications and NO_COLOR overrides.
//
// Beats:
//   1. Define ThemePalette records holding ANSI color and style sequences.
//   2. Resolve theme palettes by name with fallback to default.
//   3. Render visual status badges for verification states.
//   4. Export terminal palette accessors.

type ThemePalette = struct {
    primary: String,
    secondary: String,
    accent: String,
    success: String,
    warning: String,
    danger: String,
    dim: String,
    bold: String,
    reset: String
};

pub fn get_theme(name: String) -> ThemePalette {
    if name == "monochrome" {
        return ThemePalette {
            primary: "", secondary: "", accent: "", success: "",
            warning: "", danger: "", dim: "", bold: "", reset: ""
        };
    }
    if name == "ember" {
        return ThemePalette {
            primary: "\033[38;5;208m", secondary: "\033[38;5;214m", accent: "\033[38;5;220m",
            success: "\033[38;5;148m", warning: "\033[38;5;214m", danger: "\033[38;5;196m",
            dim: "\033[38;5;240m", bold: "\033[1m", reset: "\033[0m"
        };
    }
    if name == "ocean" {
        return ThemePalette {
            primary: "\033[38;5;39m", secondary: "\033[38;5;75m", accent: "\033[38;5;45m",
            success: "\033[38;5;48m", warning: "\033[38;5;221m", danger: "\033[38;5;203m",
            dim: "\033[38;5;242m", bold: "\033[1m", reset: "\033[0m"
        };
    }
    if name == "matrix" {
        return ThemePalette {
            primary: "\033[38;5;46m", secondary: "\033[38;5;40m", accent: "\033[38;5;82m",
            success: "\033[38;5;118m", warning: "\033[38;5;190m", danger: "\033[38;5;196m",
            dim: "\033[38;5;238m", bold: "\033[1m", reset: "\033[0m"
        };
    }
    if name == "cyber" {
        return ThemePalette {
            primary: "\033[38;5;199m", secondary: "\033[38;5;51m", accent: "\033[38;5;213m",
            success: "\033[38;5;85m", warning: "\033[38;5;227m", danger: "\033[38;5;197m",
            dim: "\033[38;5;241m", bold: "\033[1m", reset: "\033[0m"
        };
    }
    return ThemePalette {
        primary: "\033[38;5;51m", secondary: "\033[38;5;39m", accent: "\033[38;5;141m",
        success: "\033[38;5;82m", warning: "\033[38;5;220m", danger: "\033[38;5;196m",
        dim: "\033[38;5;242m", bold: "\033[1m", reset: "\033[0m"
    };
}
