// # oocrc32 Render Subsystem Unit Tests
//
// Logline: Verification anchors for terminal visual rendering and JSON serialization.
//
// Setup: Executes themed render passes and JSON structure validations against synthetic checksum results.
//
// Beats:
//   1. Verify theme palette resolution and fallback behavior.
//   2. Verify human-readable checksum line formatting.
//   3. Verify manifest verification summary reporting.
//   4. Verify JSON serialization of results and demo suites.

import "core/crc_types.oo";
import "core/crc_demo.oo";
import "render/crc_theme.oo";
import "render/crc_view.oo";
import "render/crc_json.oo";

pub fn test_themes() -> Bool {
    let mono: ThemePalette = get_theme("monochrome");
    if mono.bold != "" {
        return false;
    }
    let def_th: ThemePalette = get_theme("default");
    if chars_len(def_th.bold) == 0 {
        return false;
    }
    return true;
}

pub fn test_views() -> Bool {
    let mono: ThemePalette = get_theme("monochrome");
    let res: CrcResult = CrcResult {
        input_name: "test.bin",
        crc_hex: "cbf43926",
        crc_dec: 3421780262,
        bytes_count: 9,
        algorithm: "ieee"
    };

    let line: String = render_crc_line(res, false, mono);
    if !str_contains(line, "cbf43926") {
        return false;
    }
    if !str_contains(line, "test.bin") {
        return false;
    }

    let items: List[CrcCheckItem] = build_demo_manifest_items();
    let report: String = render_check_results(items, mono);
    if !str_contains(report, "3 passed") {
        return false;
    }

    return true;
}

pub fn test_json() -> Bool {
    let res: CrcResult = CrcResult {
        input_name: "sample.txt",
        crc_hex: "e3069283",
        crc_dec: 3808858755,
        bytes_count: 9,
        algorithm: "castagnoli"
    };

    let j: String = crc_to_json(res);
    if !str_contains(j, "\"crc_hex\": \"e3069283\"") {
        return false;
    }
    if !str_contains(j, "\"algorithm\": \"castagnoli\"") {
        return false;
    }

    let items: List[CrcCheckItem] = build_demo_manifest_items();
    let demo_res: List[CrcResult] = build_demo_results();
    let dj: String = demo_to_json(demo_res, items);
    if !str_contains(dj, "\"tool\": \"oocrc32\"") {
        return false;
    }
    if !str_contains(dj, "\"manifest_check\":") {
        return false;
    }

    return true;
}

pub fn run_render_tests() -> Bool {
    if !test_themes() {
        return false;
    }
    if !test_views() {
        return false;
    }
    if !test_json() {
        return false;
    }
    return true;
}
